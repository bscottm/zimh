{
  "version": 3,
  "configurePresets": [
    {
      "name": "address-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_ADDRESS": "On"
      }
    },
    {
      "name": "thread-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_THREAD": "On"
      }
    },
    {
      "name": "memory-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_MEMORY": "On"
      }
    },
    {
      "name": "undefined-sanitizer",
      "hidden": true,
      "cacheVariables": {
        "SANITIZE_UNDEFINED": "On"
      }
    },
    {
      "name": "windows-ninja-multiconfig",
      "displayName": "Windows build: Ninja Multi-Config + vcpkg",
      "description": "Multi-configuration generator for Release, Debug, and RelWithDebInfo targets.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-win64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang",
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug;RelWithDebInfo",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "windows-ninja-asan",
      "displayName": "Windows: Ninja Multi-Config + ASan",
      "inherits": ["windows-ninja-multiconfig", "address-sanitizer"]
    },
    {
      "name": "windows-vs2022",
      "displayName": "VS2022-x64",
      "description": "VS 2022 Windows build using vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-vs2022",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "windows-vs2022-asan",
      "displayName": "Windows: VS 2022 Windows + ASan",
      "inherits": ["windows-vs2022", "address-sanitizer"]
    },
    {
      "name": "windows-vs2026",
      "displayName": "VS2026-x64",
      "description": "VS 2026 Windows build using vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build-vs2026",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "windows-vs2026-asan",
      "displayName": "Windows: VS 2026 Windows + ASan",
      "inherits": ["windows-vs2026", "address-sanitizer"]
    },
    {
      "name": "make-debug", 
      "displayName": "Makefile Debug", 
      "description": "Makefile-based debug build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "make-release", 
      "displayName": "Makefile Release", 
      "description": "Makefile-based release build",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-base",
      "displayName": "Ninja (base flags)",
      "description": "Ninja base configuration",
      "generator": "Ninja",
      "hidden": true
    },
    {
      "name": "ninja-debug", 
      "displayName": "Ninja Debug", 
      "description": "Ninja-based debug build",
      "inherits": ["ninja-base"],
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release", 
      "displayName": "Ninja Release", 
      "description": "Ninja-based release build",
      "inherits": ["ninja-base"],
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ninja-relwithdebinfo", 
      "displayName": "Ninja RelWithDebInfo", 
      "description": "Ninja-based optimized build with debug symbols",
      "inherits": ["ninja-base"],
      "binaryDir": "${sourceDir}/build/RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ninja-sanitizer-asan", 
      "displayName": "Ninja Optimized + ASan",
      "description": "Ninja RelWithDebInfo with address sanitizer",
      "inherits": ["ninja-relwithdebinfo", "address-sanitizer"]
    },
    {
      "name": "ninja-sanitizer-tsan", 
      "displayName": "Ninja Optimized + TSan", 
      "description": "Ninja RelWithDebInfo with thread sanitizer",
      "inherits": ["ninja-relwithdebinfo", "thread-sanitizer"]
    },
    {
      "name": "ninja-sanitizer-msan", 
      "displayName": "Ninja Optimized + MSan", 
      "description": "Ninja RelWithDebInfo with memory sanitizer",
      "inherits": ["ninja-relwithdebinfo", "memory-sanitizer"]
    },
    {
      "name": "ninja-sanitizer-ubsan", 
      "displayName": "Ninja Optimized + UBSan", 
      "description": "Ninja RelWithDebInfo with undefined behavior sanitizer",
      "inherits": ["ninja-relwithdebinfo", "undefined-sanitizer"]
    },
    {
      "name": "xcode-debug", 
      "displayName": "XCode Debug", 
      "description": "macOS XCode-based debug build",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "xcode-release", 
      "displayName": "XCode Release", 
      "description": "macOS XCode-based release build",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
