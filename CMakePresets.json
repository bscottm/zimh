      "displayName": "Build: Makefile Debug"
    },
    {
      "name": "make-release",
      "configurePreset": "make-release",
      "configuration": "Release",
      "displayName": "Build: Makefile Release"
    },
    {
      "name": "ninja-debug",
      "configurePreset": "ninja-debug",
      "configuration": "Debug",
      "displayName": "Build: Ninja Debug"
    },
    {
      "name": "ninja-release",
      "configurePreset": "ninja-release",
      "configuration": "Release",
      "displayName": "Build: Ninja Release"
    },
    {
      "name": "xcode-debug",
      "configurePreset": "xcode-debug",
      "configuration": "Debug",
      "displayName": "Build: Xcode Debug"
    },
    {
      "name": "xcode-release",
      "configurePreset": "xcode-release",
      "configuration": "Release",
      "displayName": "Build: Xcode Release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-multiconfig",
      "configuration": "Release",
      "displayName": "Test: Windows Ninja multiconfig Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8, "timeout": 300 }
    },
    {
