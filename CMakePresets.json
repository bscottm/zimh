{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-ninja-multiconfig",
      "displayName": "Windows build: Ninja Multi-Config + vcpkg",
      "description": "Multi-configuration generator for Release and Debug targets.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-win64",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang",
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "windows-vs2022",
      "displayName": "VS2022-x64",
      "description": "VS 2022 Windows build using vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build-vs2022",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "windows-vs2026",
      "displayName": "VS2026-x64",
      "description": "VS 2026 Windows build using vcpkg",
      "generator": "Visual Studio 18 2026",
      "architecture": { "value": "x64", "strategy": "external" },
      "toolset": { "value": "host=x64", "strategy": "set" },
      "binaryDir": "${sourceDir}/build-vs2026",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded$<$<CONFIG:Debug>:Debug>",
        "VCPKG_INSTALL_OPTIONS": "--no-print-usage"
      }
    },
    {
      "name": "ninja-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "ninja-debug", 
      "inherits": "ninja-base",
      "displayName": "Ninja Debug", 
      "description": "Ninja-based debug build",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-release", 
      "inherits": "ninja-base",
      "displayName": "Ninja Release", 
      "description": "Ninja-based release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "make-base",
      "hidden": true,
      "generator": "Unix Makefiles"
    },
    {
      "name": "make-debug", 
      "inherits": "make-base",
      "displayName": "Makefile Debug", 
      "description": "Makefile-based debug build",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "make-release", 
      "inherits": "make-base",
      "displayName": "Makefile Release", 
      "description": "Makefile-based release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "xcode-base",
      "hidden": true,
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "xcode-debug", 
      "inherits": "xcode-base",
      "displayName": "XCode Debug", 
      "description": "macOS XCode-based debug build",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "xcode-release", 
      "inherits": "xcode-base",
      "displayName": "XCode Release", 
      "description": "macOS XCode-based release build",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-ninja-release",
      "configurePreset": "windows-ninja-multiconfig",
      "configuration": "Release",
      "displayName": "Build: Windows Ninja Release"
    },
    {
      "name": "windows-ninja-debug",
      "configurePreset": "windows-ninja-multiconfig",
      "configuration": "Debug",
